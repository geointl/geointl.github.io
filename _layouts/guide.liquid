---
layout: default
---
<link
  rel="stylesheet"
  href="{{ site.third_party_libraries.tocbot.url.css }}"
  integrity="{{ site.third_party_libraries.tocbot.integrity.css }}"
  crossorigin="anonymous"
>
<script
  defer
  src="{{ site.third_party_libraries.tocbot.url.js }}"
  integrity="{{ site.third_party_libraries.tocbot.integrity.js }}"
  crossorigin="anonymous"
></script>

<style>
  .guide-sidebar {
    position: sticky;
    top: 5.5rem;
    max-height: calc(100vh - 6.5rem);
    overflow-y: auto;
    padding-right: 1rem;
    border-right: 1px solid var(--global-divider-color, #dee2e6);
  }

  .guide-nav-label {
    margin: 0 0 0.75rem;
    padding: 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--global-text-color-light, #6c757d);
  }

  .guide-nav {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .guide-nav > li {
    margin-bottom: 0.125rem;
  }

  .guide-nav > li > a {
    display: block;
    padding: 0.45rem 0.75rem;
    border-left: 2px solid transparent;
    border-radius: 0 0.25rem 0.25rem 0;
    color: var(--global-text-color, #333);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.45;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .guide-nav > li > a:hover {
    background: color-mix(in srgb, var(--global-theme-color, #4285f4) 6%, transparent);
    color: var(--global-theme-color, #4285f4);
  }

  .guide-nav > li.active > a {
    background: color-mix(in srgb, var(--global-theme-color, #4285f4) 10%, transparent);
    border-left-color: var(--global-theme-color, #4285f4);
    color: var(--global-theme-color, #4285f4);
    font-weight: 600;
  }

  .guide-nav .toc-sidebar {
    margin: 0.25rem 0 1rem;
    padding-left: 0;
    font-size: 0.8125rem;
    position: static !important;
  }

  .guide-nav li.active .toc-sidebar::before {
    content: "On this page";
    display: block;
    margin: 0.5rem 0 0.35rem 0.75rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--global-text-color-light, #6c757d);
  }

  .guide-nav .toc-sidebar .toc-list {
    margin: 0 0 0 0.75rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--global-divider-color, #dee2e6);
  }

  .guide-nav .toc-sidebar .toc-link {
    color: var(--global-text-color-light, #6c757d);
    text-decoration: none;
    display: block;
    padding: 0.2rem 0.5rem 0.2rem 0;
    line-height: 1.4;
    border-radius: 0.2rem;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .guide-nav .toc-sidebar .toc-link:hover {
    color: var(--global-theme-color, #4285f4);
    background: color-mix(in srgb, var(--global-theme-color, #4285f4) 6%, transparent);
  }

  .guide-nav .toc-sidebar .toc-link.is-active-link {
    color: var(--global-theme-color, #4285f4);
    font-weight: 600;
  }

  .guide-content .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--global-divider-color, #dee2e6);
  }

  .guide-content .post-title {
    margin-bottom: 0.625rem;
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .guide-content .post-description {
    margin-bottom: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--global-text-color-light, #6c757d);
  }

  .guide-article {
    max-width: 48rem;
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .guide-article > :first-child {
    margin-top: 0;
  }

  .guide-article p {
    margin-bottom: 1.25rem;
  }

  .guide-article h2 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-top: 0.75rem;
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.3;
    border-top: 1px solid var(--global-divider-color, #dee2e6);
  }

  .guide-article h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .guide-article h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .guide-article h4 {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .guide-article ul,
  .guide-article ol {
    margin-top: 0;
    margin-bottom: 1.25rem;
    padding-left: 1.625rem;
  }

  .guide-article li {
    margin-bottom: 0.375rem;
  }

  .guide-article li:last-child {
    margin-bottom: 0;
  }

  .guide-article hr {
    margin: 2rem 0;
  }

  .guide-article code {
    font-size: 0.875em;
    padding: 0.125rem 0.35rem;
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--global-text-color, #333) 6%, transparent);
  }

  .guide-article pre {
    margin: 1.25rem 0;
    padding: 0.875rem 1rem;
    border-radius: 0.375rem;
    overflow-x: auto;
    background: color-mix(in srgb, var(--global-text-color, #333) 6%, transparent);
  }

  .guide-article pre code {
    padding: 0;
    background: transparent;
  }

  .guide-article table:not(.table) {
    margin: 1.25rem 0;
  }

  /* Muted blockquotes (attributions, asides — not admonitions) */
  .guide-article blockquote:not(.markdown-alert) {
    margin: 1rem 0 1.5rem;
    padding: 0.625rem 0 0.625rem 0.875rem;
    border: none;
    border-left: 2px solid var(--global-divider-color, #dee2e6);
    border-radius: 0;
    background: transparent;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--global-text-color-light, #6c757d);
  }

  .guide-article blockquote:not(.markdown-alert) p,
  .guide-article blockquote:not(.markdown-alert) li {
    margin-bottom: 0.5rem;
    color: var(--global-text-color-light, #6c757d);
  }

  .guide-article blockquote:not(.markdown-alert) p:last-child,
  .guide-article blockquote:not(.markdown-alert) li:last-child {
    margin-bottom: 0;
  }

  .guide-article blockquote:not(.markdown-alert) a {
    color: var(--global-text-color-light, #6c757d);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--global-text-color-light, #6c757d) 45%, transparent);
  }

  .guide-article blockquote:not(.markdown-alert) a:hover {
    color: var(--global-theme-color, #4285f4);
    text-decoration-color: currentColor;
  }

  .guide-article blockquote:not(.markdown-alert) ul {
    margin: 0.375rem 0 0;
    padding-left: 1.25rem;
  }

  /* Material-style admonitions */
  .guide-article blockquote.markdown-alert {
    margin: 1.5rem 0;
    padding: 0.75rem 1rem;
    border: none;
    border-left: 0.25rem solid;
    border-radius: 0.25rem;
    font-size: inherit;
    line-height: 1.65;
    box-shadow: none;
  }

  .markdown-alert-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .markdown-alert-title i {
    font-size: 0.9375rem;
    opacity: 0.9;
  }

  .markdown-alert p {
    margin-bottom: 0.75rem;
  }

  .markdown-alert p:last-child {
    margin-bottom: 0;
  }

  .markdown-alert-note {
    border-left-color: #448aff;
    background: color-mix(in srgb, #448aff 11%, var(--global-card-bg-color, #f6f8fa));
  }

  .markdown-alert-note .markdown-alert-title {
    color: #448aff;
  }

  .markdown-alert-tip {
    border-left-color: #00bfa5;
    background: color-mix(in srgb, #00bfa5 11%, var(--global-card-bg-color, #f6f8fa));
  }

  .markdown-alert-tip .markdown-alert-title {
    color: #00a88f;
  }

  .markdown-alert-important {
    border-left-color: #7c4dff;
    background: color-mix(in srgb, #7c4dff 11%, var(--global-card-bg-color, #f6f8fa));
  }

  .markdown-alert-important .markdown-alert-title {
    color: #7c4dff;
  }

  .markdown-alert-warning {
    border-left-color: #ff9100;
    background: color-mix(in srgb, #ff9100 11%, var(--global-card-bg-color, #f6f8fa));
  }

  .markdown-alert-warning .markdown-alert-title {
    color: #e65100;
  }

  .markdown-alert-caution {
    border-left-color: #ff5252;
    background: color-mix(in srgb, #ff5252 11%, var(--global-card-bg-color, #f6f8fa));
  }

  .markdown-alert-caution .markdown-alert-title {
    color: #ff5252;
  }

  @media (max-width: 575.98px) {
    .guide-sidebar {
      position: static;
      max-height: none;
      margin-bottom: 1.5rem;
      border-right: none;
      border-bottom: 1px solid var(--global-divider-color, #dee2e6);
      padding-bottom: 1rem;
    }

    .guide-content .post-title {
      font-size: 1.625rem;
    }
  }
</style>

{% assign guide_pages = site.guide | sort: 'nav_order' %}
{% assign is_overview = false %}
{% if page.url == '/guide/' or page.url == '/guide/index.html' %}
  {% assign is_overview = true %}
{% endif %}

<div class="row guide-layout">
  <div class="col-sm-3">
    <nav class="guide-sidebar" aria-label="Lab Guide navigation">
      <p class="guide-nav-label">Lab Guide</p>
      <ul class="guide-nav">
        <li class="{% if is_overview %}active{% endif %}">
          <a href="{{ '/guide/' | relative_url }}">Overview</a>
          {% if is_overview %}
            <nav
              id="toc-sidebar"
              class="toc toc-sidebar"
              aria-label="Table of contents"
              data-toc-collapse="expanded"
              data-toc-collapse-depth="{{ page.toc.collapse_depth | default: 3 }}"
            ></nav>
          {% endif %}
        </li>
        {% for doc in guide_pages %}
          <li class="{% if page.url == doc.url %}active{% endif %}">
            <a href="{{ doc.url | relative_url }}">{{ doc.title }}</a>
            {% if page.url == doc.url %}
              <nav
                id="toc-sidebar"
                class="toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="expanded"
                data-toc-collapse-depth="{{ doc.toc.collapse_depth | default: 3 }}"
              ></nav>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>

  <div class="col-sm-9">
    <div class="post guide-content">
      <header class="post-header">
        <h1 class="post-title">{{ page.title }}</h1>
        {% if page.description %}
          <p class="post-description">{{ page.description }}</p>
        {% endif %}
      </header>
      <article class="guide-article">
        {{ content }}
      </article>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const ALERT_TYPES = {
      NOTE: { class: "note", icon: "fa-circle-info", label: "Note" },
      TIP: { class: "tip", icon: "fa-lightbulb", label: "Tip" },
      IMPORTANT: { class: "important", icon: "fa-circle-exclamation", label: "Important" },
      WARNING: { class: "warning", icon: "fa-triangle-exclamation", label: "Warning" },
      CAUTION: { class: "caution", icon: "fa-circle-exclamation", label: "Caution" },
    };

    document.querySelectorAll(".guide-article blockquote").forEach((blockquote) => {
      const firstParagraph = blockquote.querySelector("p");
      if (!firstParagraph) return;

      const match = firstParagraph.textContent.trim().match(/^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*(.*)$/s);
      if (!match) return;

      const typeKey = match[1];
      const config = ALERT_TYPES[typeKey];
      if (!config) return;

      const remainder = match[2].trim();
      if (remainder) {
        firstParagraph.textContent = remainder;
      } else {
        firstParagraph.remove();
      }

      blockquote.classList.add("markdown-alert", `markdown-alert-${config.class}`);

      const title = document.createElement("p");
      title.className = "markdown-alert-title";
      title.innerHTML = `<i class="fa-solid ${config.icon}" aria-hidden="true"></i><span>${config.label}</span>`;
      blockquote.insertBefore(title, blockquote.firstChild);
    });
  });
</script>
