---
layout: page
---
<style>
  /* Shrink PI photo from the gem default of 30% */
  @media (min-width: 576px) {
    .post .profile {
      width: 20%;
      max-width: 200px;
    }
  }

  .pi-social {
    margin-top: 1rem;
    text-align: left;
  }

  .pi-social .contact-icons {
    font-size: 1.4rem;
  }

  .contact-icons a {
    margin-right: 0.7rem;
    color: var(--global-text-color, #333);
  }

  .contact-icons a:hover {
    color: var(--global-theme-color, #4285f4);
  }

  .people-section h2.section-title {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--global-divider-color, #dee2e6);
  }

  .member-grid > .col {
    padding-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .member-grid > .col {
      flex: 0 0 25%;
      max-width: 25%;
    }
  }

  .member-card figure {
    margin: 0;
  }

  @media (max-width: 767px) {
    .member-card {
      max-width: 300px;
      margin: 0 auto;
    }
  }

  /* Uniform portrait crop so any headshot size/aspect lines up in the grid */
  .member-card .card-img-top {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .member-photo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: var(--global-text-color-light, #aaa);
    background-color: var(--global-divider-color, #eee);
  }

  .member-card .card-body {
    padding: 1rem 1.25rem;
  }

  .member-card .card-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
  }

  .member-card .card-text {
    margin-bottom: 0.25rem;
  }

  .member-card .contact-icons {
    font-size: 1.15rem;
    margin-top: 0.5rem;
  }
</style>

<div class="post">
  <article class="people-section">

    {% comment %}PI section — full-width floated layout (same as gem default, photo width reduced via CSS above){% endcomment %}
    {% if page.pi %}
      {% assign pi_label = page.pi_title | default: 'Principal Investigator' %}
      <h2 class="section-title">{{ pi_label }}</h2>
      {% for profile in page.pi %}
        <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if profile.image %}
            {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
            {% if profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.2}}px, (min-width: 576px) 20vw, 95vw"{% endcapture %}
            {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.image %}
          {% endif %}
          {% if profile.more_info %}
            <div class="more-info">{{ profile.more_info }}</div>
          {% endif %}
        </div>
        <div class="clearfix">
          {% if profile.content %}
            {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
            {{ profile_content | markdownify }}
          {% endif %}
          {% if profile.social %}
            <div class="pi-social">
              <div class="contact-icons">{% social_links %}</div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}

    {{ content }}

    {% comment %}Member sections — 4-per-row card grid{% endcomment %}
    {% assign member_keys = 'postdocs,phd_students,ms_students,undergrads,alumni' | split: ',' %}
    {% assign member_labels = "Postdoctoral Researchers,PhD Students,Master's Students,Undergraduate Students,Alumni" | split: ',' %}

    {% for key in member_keys %}
      {% assign group = page[key] %}
      {% if group and group.size > 0 %}
        <h2 class="section-title">{{ member_labels[forloop.index0] }}</h2>
        <div class="row row-cols-1 member-grid">
          {% for member in group %}
            <div class="col">
              <div class="card h-100 member-card">
                {% assign member_img_path = member.image | prepend: 'assets/img/members/' %}
                {% capture member_img_exists %}{% file_exists {{ member_img_path }} %}{% endcapture %}
                {% if member.image and member_img_exists == 'true' %}
                  {% include figure.liquid path=member_img_path class='card-img-top' sizes='(min-width: 768px) 220px, 95vw' alt=member.name %}
                {% else %}
                  <div class="card-img-top member-photo-placeholder"><i class="fa-solid fa-user"></i></div>
                {% endif %}

                <div class="card-body">
                  <h3 class="card-title">{{ member.name }}</h3>
                  {% if member.start and member.end %}
                    <p class="card-text">{{ member.start }}&ndash;{{ member.end }}</p>
                  {% elsif member.start %}
                    <p class="card-text">Since {{ member.start }}</p>
                  {% endif %}
                  {% if member.topics %}
                    <p class="card-text">{{ member.topics }}</p>
                  {% endif %}
                  {% if member.email or member.url or member.github_username or member.linkedin_username %}
                    <div class="contact-icons">
                      {%- if member.email -%}
                        <a href="mailto:{{ member.email }}" title="Email"><i class="fa-solid fa-envelope"></i></a>
                      {%- endif -%}
                      {%- if member.url -%}
                        <a href="{{ member.url }}" title="Website" rel="external nofollow noopener" target="_blank"
                          ><i class="fa-solid fa-globe"></i
                        ></a>
                      {%- endif -%}
                      {%- if member.github_username -%}
                        <a href="https://github.com/{{ member.github_username }}" title="GitHub" rel="external nofollow noopener" target="_blank"
                          ><i class="fa-brands fa-github"></i
                        ></a>
                      {%- endif -%}
                      {%- if member.linkedin_username -%}
                        <a
                          href="https://www.linkedin.com/in/{{ member.linkedin_username }}"
                          title="LinkedIn"
                          rel="external nofollow noopener"
                          target="_blank"
                          ><i class="fa-brands fa-linkedin"></i
                        ></a>
                      {%- endif -%}
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endfor %}

  </article>
</div>
